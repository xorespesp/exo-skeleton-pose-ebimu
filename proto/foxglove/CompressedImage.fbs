// Ported from: https://github.com/foxglove/foxglove-sdk/tree/f590fd38686a46a347d51443b71f0e467023d956/schemas/flatbuffer/CompressedImage.fbs

include "Time.fbs";

namespace foxglove;

/// A compressed image
table CompressedImage {
  /// Timestamp of image
  timestamp:Time (id: 0);

  /// Frame of reference for the image. The origin of the frame is the optical center of the camera. +x points to the right in the image, +y points down, and +z points into the plane of the image.
  frame_id:string (id: 1);

  /// Compressed image data
  data:[uint8] (id: 2);

  /// Image format
  /// 
  /// Supported values: `jpeg`, `png`, `webp`, `avif`
  format:string (id: 3);
}

root_type CompressedImage;
