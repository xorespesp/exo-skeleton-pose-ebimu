// exo-skeleton-pose network protocol.
//
// codegen:
//   C++ : flatc --cpp    -o <out> exo_pose_proto.fbs
//   C#  : flatc --csharp -o <out> exo_pose_proto.fbs
//   JS  : flatc --ts     -o <out> exo_pose_proto.fbs

namespace exo.proto;

// Current version of this schema
enum ProtocolVersion : uint { Current = 26081901 } // YYMMDDrr

// Lower-limb joint ids.
// NOTE: A joint is an articulation point; its rotation and angles describe the
//       bend AT it, so each leg joint drives the bone leaving it toward its child.
//       Chain: Pelvis -> {R,L}Hip -> {R,L}Knee -> {R,L}Ankle -> {R,L}Foot.
enum JointId : ubyte {
    Pelvis = 0, // root of both chains; its bone is the virtual torso on the reference axis
    RHip,       // drives the right thigh
    LHip,       // drives the left thigh
    RKnee,      // drives the right shin
    LKnee,      // drives the left shin
    RAnkle,     // drives the right foot
    LAnkle,     // drives the left foot
    RFoot,      // marker end site: no bone leaves it, so its rotation and angles are always null
    LFoot       // marker end site: rotation and angles always null
}

// ---------------------------------------------------------------------------
// Client -> Server commands
// ---------------------------------------------------------------------------

// Handshake. (client's mandatory first message)
// The server holds one client at a time; a second connection is closed with 1013.
// On success -> the server replies Ack(ok) followed by a ServerStatus.
// On failure -> the server closes with WebSocket code 1002 and the reason.
table Hello {
    proto_version: uint;
}

// Starts the source the server's config names; PoseFrames follow.
// Idempotent, so a call while already streaming disturbs no captured rest pose.
table StartPoseStream {}
table StopPoseStream {} // release the source; PoseFrames stop

table CalibrateRestPose {} // latch the current pose as the rest (bind) reference; needs a running stream
table ClearRestPose {}     // drop the captured rest pose
table GetServerStatus {}   // request the current ServerStatus (reply a ServerStatus, no Ack)

// ---------------------------------------------------------------------------
// Server -> Client messages
// ---------------------------------------------------------------------------

struct Quat { x: double; y: double; z: double; w: double; }

// One joint's articulation: the animation rotation, and the measured angles of the bend.
// Every field is null on its own, present when this frame produced it.
table JointPose {
    id: JointId;

    // Rotation from the captured rest pose, relative to the parent bone (identity at rest).
    // Apply to a rig bone as: bone.local = bind * local_anim_rot
    // Null until CalibrateRestPose succeeds; the one rest-referenced field of this table.
    // Identity on the Pelvis, the fixed base the chains hang from.
    //
    // Expressed in the rig frame, fixed to the exo and independent of where the camera stands:
    //
    //   +X  the exo's left       +Y  down       +Z  behind the exo
    //
    // Every leg joint is a forward/back hinge about +X, signed by the right-hand rule about that axis;
    // a positive turn carries +Y onto +Z, swinging the bone's far end toward the exo's back.
    local_anim_rot: Quat;

    // The three angles below are sagittal-plane measurements that flow with no rest pose
    // involved, in the standard gait-analysis conventions (docs/joint_angle_convention.md).
    //
    // NOTE: the angles and `local_anim_rot` describe one pose two ways and can disagree in
    //       magnitude. They also run in opposite senses: a positive rotation swings the bone
    //       posterior, a positive segment angle means anterior. Drive a rig from the rotation;
    //       read the angles as measurements.

    // Segment Angle: attitude of the bone this joint drives, from vertically down.
    //   0 = hanging straight down, + = tilted anterior (the exo's front), - = posterior.
    //   Pelvis: 0 by definition, its bone being the torso on the reference axis.
    sagittal_segment_angle: double = null; // Unit: [rad]

    // Clinical Joint Angle (Neutral Zero Method): the bend at this joint against its parent bone.
    //   0 = neutral standing stance, + = flexion / dorsiflexion, - = extension / plantarflexion.
    //   Ankle: neutral is the foot MARKER line perpendicular to the shank. That line sits a fixed
    //          tag-placement constant off the exo's own foot axis, so 0 is not its mechanical neutral.
    //   Null on the Pelvis and the end sites.
    sagittal_clinical_angle: double = null; // Unit: [rad]

    // Included Angle: the angle between the two bones meeting at this joint, signed and continuous.
    //   pi = the bones are collinear; shrinks with flexion, grows past pi in extension.
    //   Ankle: neutral reads pi/2.
    //   Always (pi - offset) - sagittal_clinical_angle, offset = 0 for hip/knee, pi/2 for ankle.
    //   Null wherever sagittal_clinical_angle is null.
    sagittal_included_angle: double = null; // Unit: [rad]
}

// One estimation step, sent per new frame.
table PoseFrame {
    frame_seq: uint; // position of this frame in the open source's stream; restarts on every open
    timestamp_us: long; // when the source captured the frame on the Unix epoch (Unit: [us])
    has_rest_pose: bool; // false until CalibrateRestPose succeeds; `local_anim_rot` stays null until then
    joints: [JointPose]; // one entry per JointId, in enum order; index it by id
}

// Current server state, pushed after the handshake, on change, or on GetServerStatus request.
// The server picks the source; `source_name` labels it, `source_backend` is what to branch on.
table ServerStatus {
    is_streaming: bool;
    source_name: string;    // NOTE: empty while not streaming
    source_backend: string; // NOTE: empty while not streaming
    width: int;  // color frame width (Unit: [px]); 0 while not streaming
    height: int; // color frame height (Unit: [px]); 0 while not streaming
    has_rest_pose: bool;
}

// Sent when the source stream stops on its own. A failed source is released;
// one that ran out stays open, so restarting that one takes a StopPoseStream first.
table SourceStreamEnded {
    is_error: bool; // whether the source terminated abnormally
    message: string;
}

// Result of a command (ok / error msg)
table Ack { ok: bool; message: string; }

union Payload {
    Hello, StartPoseStream, StopPoseStream, CalibrateRestPose, ClearRestPose, GetServerStatus, // client -> server
    PoseFrame, ServerStatus, SourceStreamEnded, Ack                                            // server -> client
}

// Request id matches a reply to its command.
//   client -> server: MUST be non-zero, Hello included. 0 closes the socket with 1002.
//   server -> client: echoed on the Ack and on a GetServerStatus reply; 0 on the server's own
//                     pose/status/ended notifications, and on the ServerStatus after a Hello.
table Message { payload: Payload; request_id: uint = 0; }
root_type Message;
